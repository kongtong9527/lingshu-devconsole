{
  "name": "@lingshu/devconsole",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,green \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:vite": "vite",
    "build:web": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:runtime": "echo \"契约类型取自已安装的 @lingshu/runtime（母仓专属的 build:runtime 已移除）\"",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && npm run build:server && npm run build:web",
    "start": "node server/dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@lingshu/runtime": "git+https://github.com/kongtong9527/lingshu-runtime.git#v0.1.3",
    "fastify": "^4.27.0",
    "hls.js": "^1.6.16",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "jsdom": "^24.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "description": "Lingshu DevConsole：插件可视化调试台（Fastify BFF + React），不含任何内容源",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongtong9527/lingshu-devconsole.git"
  },
  "homepage": "https://github.com/kongtong9527/lingshu-devconsole#readme",
  "bugs": {
    "url": "https://github.com/kongtong9527/lingshu-devconsole/issues"
  }
}
